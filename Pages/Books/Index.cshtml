@page
@model Marcu_Alexandru_Lab2.Pages.Books.IndexModel

<h1>Index</h1>
<p><a asp-page="Create">Create New</a></p>

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(m => m.Book[0].Title)</th>
            <th>@Html.DisplayNameFor(m => m.Book[0].Price)</th>
            <th>@Html.DisplayNameFor(m => m.Book[0].PublishingDate)</th>
            <th>Publisher</th>
            <th>Author</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Book)
        {
            <tr>
                <td>@Html.DisplayFor(_ => item.Title)</td>
                <td>@Html.DisplayFor(_ => item.Price)</td>
                <td>@Html.DisplayFor(_ => item.PublishingDate)</td>
                <td>@(item.Publisher?.PublisherName)</td>
                <td>@(item.Author != null ? $"{item.Author.FirstName} {item.Author.LastName}" : "")</td>
                <td>
                    <a asp-page="Edit" asp-route-id="@item.ID">Edit</a> |
                    <a asp-page="Details" asp-route-id="@item.ID">Details</a> |
                    <a asp-page="Delete" asp-route-id="@item.ID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
