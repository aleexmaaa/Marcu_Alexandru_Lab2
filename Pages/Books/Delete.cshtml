@page "{id:int}"
@model Marcu_Alexandru_Lab2.Pages.Books.DeleteModel

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Book</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Title</dt>
        <dd class="col-sm-10">@Model.Book.Title</dd>

        <dt class="col-sm-2">Price</dt>
        <dd class="col-sm-10">@Model.Book.Price</dd>

        <dt class="col-sm-2">Publishing Date</dt>
        <dd class="col-sm-10">@Model.Book.PublishingDate</dd>

        <dt class="col-sm-2">Publisher</dt>
        <dd class="col-sm-10">@Model.Book.Publisher?.PublisherName</dd>

        <dt class="col-sm-2">Author</dt>
        <dd class="col-sm-10">
            @(Model.Book.Author != null ? $"{Model.Book.Author.FirstName} {Model.Book.Author.LastName}" : "")
        </dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Book.ID" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="Index">Back to List</a>
    </form>
</div>
